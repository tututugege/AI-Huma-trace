// PMU event list — the single source for the trace-model event vector, the RTL event bus (pmu_pkg.sv, generated by
// rtl/scripts/gen_pmu_pkg.py) and the analysis scripts.
//
// PMU_EV(NAME, GROUP, WIDTH, "meaning")
//   NAME  : event name; the event id is its position in this file (RTL: mhpmevent selector value = id)
//   GROUP : cyc / slot / commit / flow / front / mem / occ — only for reports
//   WIDTH : bits of the per-cycle increment on the event bus (how many events at most can happen in one cycle)
//
// RTL tier 1 (core_top builds these from signals that already exist, rtl/pmu/pmu_ev_core.sv): CYCLES INSTRET COMMIT_LOAD
// COMMIT_STORE COMMIT_BRANCH COMMIT_JUMP CYC_COMMIT_ZERO CYC_COMMIT_FULL BR_MISPRED FLUSH_EXCEPTION FLUSH_OTHER, plus the slot events SLOT_FIRE SLOT_KILLED SLOT_FE_EMPTY SLOT_FE_RECOV_* SLOT_BE and
// CYC_RECOVERING (top-down level 1; dispatch exports slot_valid, back_top exports dis2rob_dis_fire).
// The other events need new ports (dispatch, ICache, DCache, LSU) and are only in the trace-model for now.
//
// Every event is a per-cycle increment of one signal the core already has (a valid bit, a count of valid bits, an
// occupancy), so each one is one small adder in the counter block. The slot events use DECODE_WIDTH = 8 slots/cycle at
// the dispatch stage; the identity   slots = FIRE + FE_EMPTY + BE_* + KILLED   holds every cycle (checked by PMU=1).

// ---- cycle / retire ---------------------------------------------------------------------------------------------
PMU_EV(CYCLES,               cyc,    1, "cycles (mcycle)")
PMU_EV(INSTRET,              commit, 4, "instructions committed (minstret)")
PMU_EV(COMMIT_LOAD,          commit, 4, "loads committed (every AMO counts as a load and a store)")
PMU_EV(COMMIT_STORE,         commit, 4, "stores committed (every AMO counts as a load and a store)")
PMU_EV(COMMIT_BRANCH,        commit, 4, "conditional branches committed")
PMU_EV(COMMIT_JUMP,          commit, 4, "JAL/JALR committed")
PMU_EV(COMMIT_RET,           commit, 4, "returns committed (JALR x0, ra)")
PMU_EV(COMMIT_MISPRED_BR,    commit, 4, "committed conditional branches that were mispredicted")
PMU_EV(COMMIT_MISPRED_JALR,  commit, 4, "committed JALR (not ret) that were mispredicted")
PMU_EV(COMMIT_MISPRED_RET,   commit, 4, "committed returns that were mispredicted")
PMU_EV(CYC_COMMIT_ZERO,      commit, 1, "cycles with no instruction committed")
PMU_EV(CYC_COMMIT_FULL,      commit, 1, "cycles with COMMIT_WIDTH instructions committed")
// ---- top-down slots (dispatch stage, DECODE_WIDTH slots per cycle) -----------------------------------------------------
PMU_EV(SLOT_FIRE,            slot,   4, "slots that dispatched an instruction (allocation; retiring + bad-spec waste)")
PMU_EV(SLOT_KILLED,          slot,   4, "valid slots dropped on a flush/mispredict cycle (bad speculation)")
PMU_EV(SLOT_FE_EMPTY,        slot,   4, "slots with no instruction (all frontend causes below sum to this)")
PMU_EV(SLOT_FE_RECOV_MISPRED,slot,   4, "  empty slots while refilling after a branch mispredict (bad speculation, not frontend)")
PMU_EV(SLOT_FE_RECOV_FLUSH,  slot,   4, "  empty slots while refilling after a pipeline flush (bad speculation, not frontend)")
PMU_EV(SLOT_FE_ICACHE,       slot,   4, "  empty slots, ICache miss in progress (fetch latency)")
PMU_EV(SLOT_FE_ITLB,         slot,   4, "  empty slots, ITLB miss in progress (fetch latency)")
PMU_EV(SLOT_FE_OTHER,        slot,   4, "  empty slots, other (fetch bandwidth: short fetch groups, taken-branch bubbles, FTQ/IB)")
PMU_EV(SLOT_BE,             slot,   4, "slots stalled by the backend (sum of the SLOT_BE_* causes below; the RTL has only this total)")
PMU_EV(SLOT_BE_ROB_FULL,     slot,   4, "slots stalled: ROB full")
PMU_EV(SLOT_BE_FLUSH_WAIT,   slot,   4, "slots stalled: a flush-type instruction is at the ROB head")
PMU_EV(SLOT_BE_SERIAL,       slot,   4, "slots stalled: CSR/AMO/WFI serialization (waits for an empty ROB, or exclusive dispatch)")
PMU_EV(SLOT_BE_LDQ_FULL,     slot,   4, "slots stalled: no load-queue entry")
PMU_EV(SLOT_BE_STQ_FULL,     slot,   4, "slots stalled: no store-queue entry")
PMU_EV(SLOT_BE_IQ_FULL,      slot,   4, "slots stalled: issue queue full")
PMU_EV(SLOT_BE_HEAD_MISS,    slot,   4, "backend-stalled slots while the oldest incomplete instruction is a load/store that missed L1D")
PMU_EV(SLOT_BE_HEAD_MEM,     slot,   4, "backend-stalled slots while the oldest incomplete instruction is a load/store (no L1D miss)")
PMU_EV(SLOT_BE_HEAD_CORE,    slot,   4, "backend-stalled slots while the oldest incomplete instruction is not a memory op")
PMU_EV(SLOT_BE_HEAD_DONE,    slot,   4, "backend-stalled slots while the ROB head is complete or the ROB is empty")
// ---- control flow / recovery ----------------------------------------------------------------------------------------
PMU_EV(BR_MISPRED,           flow,   1, "branch mispredict redirects (includes wrong-path branches)")
PMU_EV(FLUSH_EXCEPTION,      flow,   1, "pipeline flushes: exception")
PMU_EV(FLUSH_OTHER,          flow,   1, "pipeline flushes: everything but exceptions (fence/fence.i/sfence/CSR/MMIO/xRET/interrupt)")
PMU_EV(CYC_RECOVERING,       flow,   1, "cycles between a redirect and the first instruction reaching dispatch")
PMU_EV(MOVE_ELIMINATED,      flow,   4, "moves eliminated at rename (dispatched)")
// ---- frontend -------------------------------------------------------------------------------------------------------
PMU_EV(ICACHE_ACCESS,        front,  1, "ICache requests accepted")
PMU_EV(ICACHE_MISS,          front,  1, "ICache misses (refill started)")
PMU_EV(CYC_ICACHE_MISS_BUSY, front,  1, "cycles the ICache is refilling")
PMU_EV(ITLB_ACCESS,          front,  1, "ITLB lookups")
PMU_EV(ITLB_MISS,            front,  1, "ITLB misses (page walk needed)")
// ---- memory ---------------------------------------------------------------------------------------------------------
PMU_EV(DC_LD_HIT,            mem,    2, "L1D load stage-2 hits")
PMU_EV(DC_LD_MISS,           mem,    2, "L1D load stage-2 misses (new or merged)")
PMU_EV(DC_LD_MISS_OUT,       mem,    7, "load-queue entries with an outstanding L1D miss, summed over cycles (MLP numerator)")
PMU_EV(CYC_LD_MISS_OUT,      mem,    1, "cycles with at least one outstanding L1D load miss (MLP denominator)")
PMU_EV(PF_ISSUED,            mem,    1, "L1D prefetches issued")
PMU_EV(PF_USEFUL,            mem,    1, "demand hits on prefetched lines")
PMU_EV(PF_LATE,              mem,    1, "demand loads that merged into an in-flight prefetch")
// ---- occupancy (summed every cycle: average = event / CYCLES) ---------------------------------------------------------------
PMU_EV(OCC_ROB,              occ,    8, "ROB entries in use (valid instructions)")
PMU_EV(OCC_LDQ,              occ,    7, "load-queue entries in use")
PMU_EV(OCC_STQ,              occ,    7, "store-queue entries in use")
// ---- issue-queue detail (EXP-014; appended so the ids of the events above do not move; trace-model only, not on the RTL bus) ----
// The first slot the backend did not take because an IQ could not accept its uop: SLOT_BE_IQ_FULL = sum of the 10 events below.
// SPACE: the queue has no free entry for it.  WIDTH: it has room, but this cycle's enqueue (write-port) width of that IQ is used up.
// (A load stopped by the LD IQ enqueue width counts here, not in SLOT_BE_LDQ_FULL.)
PMU_EV(SLOT_BE_IQ_SPACE_INT,   slot,   4, "slots stalled: INT issue queue has no free entry")
PMU_EV(SLOT_BE_IQ_SPACE_LD,   slot,   4, "slots stalled: LD issue queue has no free entry")
PMU_EV(SLOT_BE_IQ_SPACE_STA,   slot,   4, "slots stalled: STA issue queue has no free entry")
PMU_EV(SLOT_BE_IQ_SPACE_STD,   slot,   4, "slots stalled: STD issue queue has no free entry")
PMU_EV(SLOT_BE_IQ_SPACE_BR,   slot,   4, "slots stalled: BR issue queue has no free entry")
PMU_EV(SLOT_BE_IQ_WIDTH_INT,   slot,   4, "slots stalled: INT issue queue enqueue width exhausted (room left)")
PMU_EV(SLOT_BE_IQ_WIDTH_LD,   slot,   4, "slots stalled: LD issue queue enqueue width exhausted (room left)")
PMU_EV(SLOT_BE_IQ_WIDTH_STA,   slot,   4, "slots stalled: STA issue queue enqueue width exhausted (room left)")
PMU_EV(SLOT_BE_IQ_WIDTH_STD,   slot,   4, "slots stalled: STD issue queue enqueue width exhausted (room left)")
PMU_EV(SLOT_BE_IQ_WIDTH_BR,   slot,   4, "slots stalled: BR issue queue enqueue width exhausted (room left)")
PMU_EV(OCC_IQ_INT,            occ,    7, "INT issue-queue entries in use")
PMU_EV(OCC_IQ_LD,            occ,    7, "LD issue-queue entries in use")
PMU_EV(OCC_IQ_STA,            occ,    7, "STA issue-queue entries in use")
PMU_EV(OCC_IQ_STD,            occ,    5, "STD issue-queue entries in use")
PMU_EV(OCC_IQ_BR,            occ,    6, "BR issue-queue entries in use")

